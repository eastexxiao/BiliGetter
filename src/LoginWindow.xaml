<Window x:Class="BiliGetter.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 B 站（手机扫码）" Width="440" Height="580"
        ThemeMode="Light" WindowStartupLocation="CenterOwner"
        Foreground="#FF1A1A1A"
        ResizeMode="NoResize" FontFamily="Microsoft YaHei UI" FontSize="13">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 二维码固定白底，避免深色主题下反色导致扫不出来 -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="10">
            <Image x:Name="ImgQr" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <TextBlock x:Name="TxtStatus" Grid.Row="1" Text="正在获取二维码…"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,14,0,14" MinHeight="42"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnBrowser" Content="在浏览器中打开" IsEnabled="False" Click="BtnBrowser_Click"/>
            <Button x:Name="BtnCopy" Content="复制链接" IsEnabled="False" Click="BtnCopy_Click"/>
            <Button x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="BiliGetter.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 B 站（手机扫码）" Width="440" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFFFF" Foreground="#FF1A1A1A"
        ResizeMode="NoResize" FontFamily="Microsoft YaHei UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFD9D9D9"/>
            <Setter Property="Foreground" Value="#FF1A1A1A"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF2F6FC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFC9D8EC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFAFAFAF"/>
                                <Setter TargetName="bd" Property="Background" Value="#FFF6F6F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 二维码固定白底，避免深色主题下反色导致扫不出来 -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="10">
            <Image x:Name="ImgQr" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <TextBlock x:Name="TxtStatus" Grid.Row="1" Text="正在获取二维码…"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,14,0,14" MinHeight="42"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnBrowser" Content="在浏览器中打开" IsEnabled="False" Click="BtnBrowser_Click"/>
            <Button x:Name="BtnCopy" Content="复制链接" IsEnabled="False" Click="BtnCopy_Click"/>
            <Button x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

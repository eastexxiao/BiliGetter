<Window x:Class="BiliGetter.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="260" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFFFF" Foreground="#FF1A1A1A"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFD9D9D9"/>
            <Setter Property="Foreground" Value="#FF1A1A1A"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF2F6FC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFC9D8EC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFAFAFAF"/>
                                <Setter TargetName="bd" Property="Background" Value="#FFF6F6F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFD9D9D9"/>
            <Setter Property="Foreground" Value="#FF1A1A1A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TxtHint" Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap"
                   Foreground="#FF5B5B5B" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="ffmpeg" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="TxtFfmpeg" Grid.Row="1" Grid.Column="1" Padding="8,6" Margin="0,0,8,8"
                 VerticalContentAlignment="Center"/>
        <Button Grid.Row="1" Grid.Column="2" Content="浏览…" MinWidth="90" Padding="16,6" Margin="0,0,0,8"
                Click="PickFfmpeg_Click"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="aria2c" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="TxtAria2c" Grid.Row="2" Grid.Column="1" Padding="8,6" Margin="0,0,8,8"
                 VerticalContentAlignment="Center"/>
        <Button Grid.Row="2" Grid.Column="2" Content="浏览…" MinWidth="90" Padding="16,6" Margin="0,0,0,8"
                Click="PickAria2c_Click"/>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" TextWrapping="Wrap" Foreground="#FF6B6B6B"
                   FontSize="12" Margin="0,8,0,0"
                   Text="建议把两个 exe 都放在 BiliGetter.exe 同目录：某些机器的「受控文件夹访问」会拦截位于其他目录的 aria2c / ffmpeg，表现为下载报 Access is denied。"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="BtnOk" Content="确定" MinWidth="96" Padding="16,6" Click="Ok_Click" IsDefault="True"/>
            <Button x:Name="BtnLater" Content="稍后" MinWidth="96" Padding="16,6" Margin="8,0,0,0" Click="Later_Click"/>
        </StackPanel>
    </Grid>
</Window>

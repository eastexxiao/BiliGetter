<Project Sdk="Microsoft.NET.Sdk">

  <!-- 命令行版：BiliGetter-cli.exe -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>BiliGetter</RootNamespace>
    <AssemblyName>BiliGetter-cli</AssemblyName>
    <!-- 本项目里有两个入口候选时，明确指定用 CliTest -->
    <StartupObject>BiliGetter.CliTest</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!--
    同一个共享核心。CliTest.cs 就在本项目目录里，由 SDK 默认通配自动包含。
    注意：CliTest 里的 ui 命令要用 MainForm 渲染界面截图，所以这个项目也依赖 WinForms。
  -->
  <ItemGroup>
    <Compile Include="..\src\*.cs" LinkBase="src" />
  </ItemGroup>

</Project>

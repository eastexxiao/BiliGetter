<Project Sdk="Microsoft.NET.Sdk">

  <!--
    B 站下载器 —— 单一自包含单文件程序。

      双击                          -> 图形界面
      BiliGetter.exe cli <命令>   -> 命令行模式（同一套核心代码）

    图形界面和命令行合并成一个 exe，是因为自包含发布每多一个 exe
    就要多带一份 .NET 运行时（约多 70~150 MB）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BiliGetter</RootNamespace>
    <AssemblyName>BiliGetter</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!--
    自包含 + 单文件：连同 .NET 运行时一起打包。
    拷到任何 64 位 Win10/11 上双击即用，不需要用户安装 .NET。
    （代价是体积：见 BASELINE.md 里的取舍说明）
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- 共享核心源码都在 ..\src\ 下 -->
  <ItemGroup>
    <Compile Include="..\src\*.cs" LinkBase="src" />
  </ItemGroup>

</Project>
